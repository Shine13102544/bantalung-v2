# คัดลอกไฟล์นี้เป็นชื่อ ".env" แล้วแก้ค่าให้เป็นของจริงก่อนรัน
# ห้าม commit ไฟล์ .env ตัวจริงขึ้น git เด็ดขาด

PORT=3000

# ใช้คำสั่ง: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# เพื่อสุ่มค่าใหม่ทุกครั้งที่ deploy จริง อย่าใช้ค่า default นี้
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# อายุ token แอดมิน (เช่น 4h, 30m, 1d)
JWT_EXPIRES_IN=4h

# โดเมนของหน้าเว็บฝั่ง frontend ที่อนุญาตให้เรียก API (CORS)
FRONTEND_ORIGIN=http://localhost:5500

# ฐานข้อมูล Turso (Cloud SQLite) - สมัครฟรีที่ turso.tech แล้วสร้างฐานข้อมูล 1 ตัว
# จะได้ค่า Database URL และ Auth Token มาใส่ตรงนี้ (ดูวิธีสร้างได้ใน README.md)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# คลังเก็บรูปภาพ Cloudinary (สลิปโอนเงิน, รูปเมนู, โปสเตอร์) - สมัครฟรีที่ cloudinary.com
# เข้า Dashboard หลังสมัคร จะเห็นค่าทั้ง 3 นี้แสดงอยู่หน้าแรกเลย
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
